{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ga.example/portal/contracts/events/v1/payloads/StatementEstimated.v1.schema.json",
  "title": "StatementEstimated payload (v1)",
  "description": "야간 배치(지급 로직 dry-run, 설계서 §4.2). → earnings_month 세액·순액(예상), status=ESTIMATED. 세액·순액은 엔진 값이며 포털은 계산하지 않는다. 모르는 필드는 허용한다(설계서 §4.5 — 소비자는 무시).",
  "type": "object",
  "required": [
    "agentId",
    "closeYm",
    "gross",
    "clawbackOffset",
    "adjustment",
    "withholdingTax",
    "net",
    "basisSeq",
    "asOf"
  ],
  "properties": {
    "agentId": {
      "$ref": "../defs.schema.json#/$defs/agentId"
    },
    "closeYm": {
      "$ref": "../defs.schema.json#/$defs/ym"
    },
    "gross": {
      "$ref": "../defs.schema.json#/$defs/won"
    },
    "clawbackOffset": {
      "$ref": "../defs.schema.json#/$defs/won"
    },
    "adjustment": {
      "$ref": "../defs.schema.json#/$defs/won"
    },
    "withholdingTax": {
      "$ref": "../defs.schema.json#/$defs/won"
    },
    "net": {
      "$ref": "../defs.schema.json#/$defs/won"
    },
    "basisSeq": {
      "type": "integer",
      "minimum": 0
    },
    "asOf": {
      "$ref": "../defs.schema.json#/$defs/instant"
    }
  }
}
